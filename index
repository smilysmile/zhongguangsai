        // ================= 1. 初始化导航与进度点 =================
        function initDots() {
            const dotsContainer = document.getElementById('dots-nav');
            dotsContainer.innerHTML = '';
            for (let i = 0; i < totalPages; i++) {
                const dot = document.createElement('button');
                dot.className = `w-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'bg-waterGlow h-4' : 'bg-gray-400/50 h-1.5'}`;
                dot.onclick = () => goToPage(i);
                dotsContainer.appendChild(dot);
            }
        }

        function goToPage(index) {
            if (index < 0 || index >= totalPages || isAnimating) return;
            isAnimating = true;
            currentPage = index;

            const wrapper = document.getElementById('pages-wrapper');
            wrapper.style.transform = `translateY(-${currentPage * 100}%)`;

            const pages = document.querySelectorAll('.h5-page');
            pages.forEach((p, idx) => {
                if (idx === currentPage) p.classList.add('active');
                else p.classList.remove('active');
            });

            const activeTheme = pages[currentPage].getAttribute('data-theme');
            const header = document.getElementById('global-header');
            if (activeTheme === 'light') {
                header.classList.remove('text-white');
                header.classList.add('text-ink');
            } else {
                header.classList.remove('text-ink');
                header.classList.add('text-white');
            }

            const pageNumStr = currentPage + 1 < 10 ? `0${currentPage + 1}` : `${currentPage + 1}`;
            document.getElementById('page-indicator').innerText = `${pageNumStr} / ${totalPages}`;
            document.getElementById('line-badge').innerText = pageBadges[currentLang][currentPage];

            const dots = document.getElementById('dots-nav').children;
            for (let i = 0; i < dots.length; i++) {
                dots[i].className = `w-1.5 rounded-full transition-all duration-300 ${i === currentPage ? 'bg-waterGlow h-4' : 'bg-gray-400/50 h-1.5'}`;
            }

            if (currentPage === 1) {
                playPage2SplitTrace();
            }

            if (currentPage === 8) {
                clearHarmonyCanvas();
            }

            if (currentPage === 9) {
                setTimeout(redrawAllMatchedLines, 720);
            }

            setTimeout(() => {
                isAnimating = false;
            }, 650);
        }

        // ================= 2. 第1页 → 第2页：水滴坠落留下流动水痕 =================
        function triggerHeroDrop() {
            const drop = document.getElementById('hero-water-drop');
            if (drop.classList.contains('dropping')) return;
            drop.classList.add('dropping');
            playWaterPlink();

            setTimeout(() => {
                goToPage(1);
                setTimeout(() => drop.classList.remove('dropping'), 650);
            }, 2750);
        }

        function playPage2SplitTrace() {
            const inflow = document.getElementById('p2-inflow-trace');
            const leftT = document.getElementById('p2-left-trace');
            const rightT = document.getElementById('p2-right-trace');
            [inflow, leftT, rightT].forEach(el => {
                if (!el) return;
                el.classList.remove('water-trace-active');
                void el.offsetWidth;
                el.classList.add('water-trace-active');
            });
            ['p2-drop-left','p2-drop-right'].forEach(id => {
                const drop = document.getElementById(id);
                if (!drop) return;
                drop.classList.remove('animate');
                void drop.getBoundingClientRect();
                drop.classList.add('animate');
            });
        }

        // ================= 3. 触摸手势 =================
        let touchStartY = 0;
        let touchStartX = 0;
        const viewport = document.getElementById('app-viewport');

        viewport.addEventListener('touchstart', (e) => {
            touchStartY = e.touches[0].clientY;
            touchStartX = e.touches[0].clientX;
        }, { passive: true });

        viewport.addEventListener('touchend', (e) => {
            const diffY = touchStartY - e.changedTouches[0].clientY;
            const diffX = touchStartX - e.changedTouches[0].clientX;

            if (currentPage === 1 && Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 45) {
                if (diffX > 0) goToPage(3);
                else goToPage(2);
                return;
            }

            if (Math.abs(diffY) > Math.abs(diffX) && Math.abs(diffY) > 45) {
                if (diffY > 0) goToPage(currentPage + 1);
                else goToPage(currentPage - 1);
            }
        }, { passive: true });

        viewport.addEventListener('wheel', (e) => {
            if (Math.abs(e.deltaY) > 30) {
                if (e.deltaY > 0) goToPage(currentPage + 1);
                else goToPage(currentPage - 1);
            }
        }, { passive: true });

        // ================= 4. Web Audio API 音效 =================
        let audioCtx = null;
        function getAudioContext() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            return audioCtx;
        }

        function playWaterPlink() {
            try {
                const ctx = getAudioContext();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(620, ctx.currentTime);
