        function playAncientInstrument(type) {
            try {
                const ctx = getAudioContext();
                const now = ctx.currentTime;

                if (type === 'flute') {
                    const notes = [523.25, 587.33, 659.25, 783.99, 880.00];
                    const eq = document.getElementById('flute-eq');
                    eq.classList.add('playing');
