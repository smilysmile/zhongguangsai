                        const gain = ctx.createGain();
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(freq, now + i * 0.36);
                        gain.gain.setValueAtTime(0.001, now + i * 0.36);
                        gain.gain.linearRampToValueAtTime(0.22, now + i * 0.36 + 0.08);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.36 + 0.45);
                        osc.connect(gain);
                        gain.connect(ctx.destination);
                        osc.start(now + i * 0.36);
                        osc.stop(now + i * 0.36 + 0.48);
