            link.href = canvas.toDataURL('image/png');
            link.click();

            showToast(currentLang === 'zh' ? "🖼️ 双语纪念明信片已保存！" : "🖼️ Bilingual Postcard Saved!");
        }

        function shareGlobalLink() {
            const text = currentLang === 'zh'
                ? "一水同源，万境共生！我刚刚体验了《黄河×尼罗河：双河文明交响》跨文化H5长卷，一起来聆听8000年前的贾湖骨笛与古埃及竖琴："
                : "One Water, One Civilization! Experience the cross-cultural journey connecting the Yellow River and the Nile:";
            const input = document.createElement('input');
            input.value = `${text} ${window.location.href}`;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);

            showToast(currentLang === 'zh' ? "🔗 双语分享文案已复制，快分享到朋友圈/海外社交吧！" : "🔗 Share link & message copied!");
        }

        // ================= 12. 双语切换与 Toast =================
        function toggleLanguage() {
            currentLang = currentLang === 'zh' ? 'en' : 'zh';
            document.getElementById('lang-label').innerText = currentLang === 'zh' ? 'EN / 中' : '中 / EN';
            document.getElementById('line-badge').innerText = pageBadges[currentLang][currentPage];

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (i18nDict[currentLang][key]) {
                    el.innerHTML = i18nDict[currentLang][key];
                }
            });

            initMatchingGame();
            showToast(currentLang === 'zh' ? "已切换至中文界面" : "Switched to English Interface");
        }

        function showToast(msg) {
            const toast = document.getElementById('toast-box');
            document.getElementById('toast-msg').innerText = msg;
            toast.classList.remove('opacity-0');
            setTimeout(() => {
                toast.classList.add('opacity-0');
            }, 2600);
        }

        window.onload = () => {
            initDots();
            initMatchingGame();
        };
    </script>
</body>
</html>
