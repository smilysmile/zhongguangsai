.p2-choice-label{display:flex;justify-content:space-between;align-items:center;font:600 8px Inter,sans-serif;letter-spacing:.14em;color:#888b81;margin:8px 0 10px;gap:8px}
.p2-choice-label span{font-family:'Noto Serif SC',serif;font-size:9px;letter-spacing:.04em}
.p2-cards{display:grid;grid-template-columns:1fr 1fr;gap:11px;position:relative;z-index:2}
.p2-river-card{min-width:0;text-align:left;border-radius:13px!important;padding:14px 13px 12px!important;background:rgba(255,255,255,.64)!important;border:1px solid rgba(61,66,57,.12)!important;display:flex;flex-direction:column;min-height:148px;transition:transform .28s,border-color .28s,box-shadow .28s!important}
.p2-river-card:hover{transform:translateY(-4px)!important;box-shadow:0 12px 28px rgba(44,56,49,.09)!important}
.gold-card{border-top:2px solid #c79b66!important}.blue-card{border-top:2px solid #82aeb1!important}
.p2-card-index{font:600 8px Inter,sans-serif;letter-spacing:.16em;color:#96988e}
.p2-card-name{font:600 17px 'Noto Serif SC',serif;color:#353a33;margin:8px 0 5px}
.p2-card-desc{font:400 10px/1.65 'Noto Serif SC',serif;color:#7b8077;min-height:34px}
.p2-card-action{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:10px;font:600 9px Inter,sans-serif;letter-spacing:.04em}
.gold-card .p2-card-action{color:#a77743}.blue-card .p2-card-action{color:#527f86}.p2-card-action b{font-size:15px;font-weight:400}
.p2-footnote{text-align:center;font:500 8px/1.5 Inter,sans-serif;letter-spacing:.06em;color:#a0a096;margin-top:13px}
@media(max-height:760px){.p1-orbit{width:220px;height:220px;margin:10px auto}.p1-main h1{font-size:26px!important}.p1-manifesto{margin-top:8px}.p2-river-art{min-height:205px;max-height:250px}.p2-river-card{min-height:132px;padding:11px!important}.p2-heading{margin-top:15px}}
@media(max-width:380px){.p1-cinematic,.p2-cinematic{padding-left:1.2rem!important;padding-right:1.2rem!important}.p2-card-name{font-size:15px}.p2-card-desc{font-size:9px}}
@media(prefers-reduced-motion:reduce){.p1-orbit-ring,.p1-orbit-core,#hero-water-drop,.source-halo,.p2-river-node{animation:none!important}}
</style>

</head>
<body>

    <!-- 全局 SVG 矿物颜料边缘晕染滤镜定义 -->
    <svg class="hidden" width="0" height="0" aria-hidden="true">
        <defs>
            <filter id="watercolor-edge" x="-15%" y="-15%" width="130%" height="130%">
                <feTurbulence type="fractalNoise" baseFrequency="0.025" numOctaves="3" seed="12" result="noise"/>
                <feDisplacementMap in="SourceGraphic" in2="noise" scale="18" xChannelSelector="R" yChannelSelector="G" result="displaced"/>
                <feGaussianBlur in="displaced" stdDeviation="1.2" result="blurred"/>
                <feMerge>
                    <feMergeNode in="blurred"/>
                </feMerge>
            </filter>
        </defs>
    </svg>

    <div id="app-viewport">

        <!-- 顶部全局悬浮栏 -->
        <header id="global-header" class="absolute top-0 left-0 right-0 z-40 px-5 pt-4 pb-2 flex items-center justify-between transition-colors duration-500 text-white">
            <div class="flex items-center space-x-2">
                <span id="header-dot" class="w-2.5 h-2.5 rounded-full bg-waterGlow animate-pulse"></span>
                <span id="page-indicator" class="font-cinzel text-xs font-bold tracking-widest">01 / 13</span>
                <span id="line-badge" class="text-[10px] px-2.5 py-0.5 rounded-full bg-white/15 backdrop-blur-xs font-medium tracking-wider">GENESIS · 起源</span>
            </div>

            <div class="flex items-center space-x-2">
                <!-- 双语切换按钮 -->
                <button onclick="toggleLanguage()" class="px-3 py-1.5 rounded-full bg-black/30 backdrop-blur-md border border-white/20 text-white text-xs font-semibold tracking-wider hover:bg-white/20 transition active:scale-95 flex items-center space-x-1.5">
                    <i data-lucide="languages" class="w-3.5 h-3.5 text-waterGlow"></i>
                    <span id="lang-label">EN / 中</span>
                </button>
            </div>
        </header>

        <!-- 右侧13页进度指示条 -->
        <div id="dots-nav" class="absolute right-3 top-1/2 -translate-y-1/2 z-30 flex flex-col space-y-1.5"></div>

        <!-- 13页叙事主容器 -->
        <main id="pages-wrapper">

            <!-- =====================================================================
                 第 1 页：【开场动画 · 水滴起源】（已去掉背景文字，水滴完美融合）
            ====================================================================== -->
            <section class="h5-page p1-cinematic active" data-index="0" data-theme="light">
                <div class="p1-grain" aria-hidden="true"></div>
                <div class="p1-topline reveal">
                    <span>FIELD NOTES&nbsp; / &nbsp;01</span>
                    <span>THE ORIGIN OF CIVILIZATION</span>
                </div>
                <div class="p1-main reveal delay-100">
                    <div class="p1-kicker"><span></span> PROLOGUE · THE SOURCE <span></span></div>
                    <h1 data-i18n="p1_title">所有文明，始于一滴水</h1>
                    <p class="p1-subtitle" data-i18n="p1_sub">All Civilizations Begin With a Single Drop of Water</p>
                    <button id="hero-drop-container" onclick="triggerHeroDrop()" class="p1-orbit" aria-label="触碰水滴，开启旅程">
                        <span class="p1-orbit-ring ring-a"></span><span class="p1-orbit-ring ring-b"></span>
                        <span class="p1-orbit-tick tick-a"></span><span class="p1-orbit-tick tick-b"></span>
                        <span class="p1-orbit-core"></span>
                        <svg id="hero-water-drop" viewBox="0 0 120 150" aria-hidden="true">
                            <defs>
                                <linearGradient id="p1Glass" x1=".15" y1="0" x2=".82" y2="1">
                                    <stop offset="0" stop-color="#fff" stop-opacity=".98"/><stop offset=".32" stop-color="#b9e6e8" stop-opacity=".86"/><stop offset=".7" stop-color="#5d9392" stop-opacity=".9"/><stop offset="1" stop-color="#294f50" stop-opacity=".98"/>
                                </linearGradient>
                                <radialGradient id="p1Shine" cx="30%" cy="24%" r="70%"><stop stop-color="#fff" stop-opacity=".95"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>
                            </defs>
                            <path d="M60 7 C49 27 17 67 17 98 C17 124 35 143 60 143 C85 143 103 124 103 98 C103 67 71 27 60 7Z" fill="url(#p1Glass)" stroke="#fff" stroke-opacity=".9" stroke-width="2"/>
                            <path d="M60 7 C49 27 17 67 17 98 C17 124 35 143 60 143 C85 143 103 124 103 98 C103 67 71 27 60 7Z" fill="url(#p1Shine)"/>
                            <path d="M42 79 Q35 94 42 107" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" opacity=".8"/>
                            <circle cx="49" cy="116" r="3" fill="#fff" opacity=".8"/>
                        </svg>
                        <span class="p1-orbit-caption">ONE DROP · INFINITE STORIES</span>
                    </button>
                    <div class="p1-rule"><span></span><i>水 · WATER · حياة</i><span></span></div>
                    <p class="p1-manifesto">从一滴水开始，<br/>看见两条大河，如何孕育不同的文明。</p>
                </div>
                <div class="p1-bottom reveal delay-200">
                    <button onclick="triggerHeroDrop()" class="p1-start"><span data-i18n="p1_btn">轻触水滴，开启文明之流</span><b>↗</b></button>
                    <span data-i18n="swipe_hint">或向上滑动 · Swipe Up</span>
                </div>
            </section>

            <section class="h5-page p2-cinematic" data-index="1" data-theme="light">
                <div class="p2-topline reveal"><span>CHAPTER&nbsp; / &nbsp;01</span><span>ONE SOURCE, TWO RIVERS</span></div>
                <div class="p2-heading reveal delay-100">
                    <div class="p2-kicker">DIVERGENCE <span>·</span> 双河初生</div>
                    <h2 data-i18n="p2_title">一水分山海，两河育文明</h2>
                    <p data-i18n="p2_sub">One Water Divides Mountains & Seas, Two Rivers Nurture Civilizations</p>
                </div>
                <div class="p2-river-art reveal delay-100">
                    <div class="p2-source"><span class="source-halo"></span><span class="source-drop"></span><small>ONE SOURCE</small></div>
                    <svg viewBox="0 0 600 360" preserveAspectRatio="xMidYMid meet" aria-label="一滴水分成黄河与尼罗河两条河流">
                        <defs>
                            <linearGradient id="p2Gold" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#e4bd83"/><stop offset="1" stop-color="#a66d32"/></linearGradient>
                            <linearGradient id="p2Blue" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#9dc6c7"/><stop offset="1" stop-color="#426f79"/></linearGradient>
                            <filter id="riverGlow"><feGaussianBlur stdDeviation="5"/></filter>
                        </defs>
                        <path class="p2-river-glow gold" d="M300 0 C300 72 220 78 175 142 S105 242 84 350"/>
                        <path class="p2-river-glow blue" d="M300 0 C300 72 380 78 425 142 S495 242 516 350"/>
                        <path id="p2-inflow-trace" class="p2-river-line source-line" d="M300 0 C300 28 300 48 300 68"/>
                        <path id="p2-left-trace" class="p2-river-line gold" d="M300 68 C300 108 220 108 175 165 S105 260 84 350"/>
                        <path id="p2-right-trace" class="p2-river-line blue" d="M300 68 C300 108 380 108 425 165 S495 260 516 350"/>
                        <circle class="p2-river-node" cx="300" cy="68" r="9"/>
                        <g id="p2-drop-left" class="p2-drop-left"><circle cx="84" cy="333" r="8" fill="#d3a66e"/><circle cx="84" cy="333" r="15" fill="none" stroke="#d3a66e" opacity=".5"/></g>
                        <g id="p2-drop-right" class="p2-drop-right"><circle cx="516" cy="333" r="8" fill="#79aeb4"/><circle cx="516" cy="333" r="15" fill="none" stroke="#79aeb4" opacity=".5"/></g>
                        <g class="p2-map-label left"><circle cx="175" cy="165" r="4"/><text x="156" y="145" text-anchor="end">黄河</text></g>
                        <g class="p2-map-label right"><circle cx="425" cy="165" r="4"/><text x="444" y="145">尼罗河</text></g>
                    </svg>
                    <div class="p2-art-caption"><span>35° N · EAST</span><span>30° N · WEST</span></div>
                </div>
                <div class="p2-choice-label reveal delay-200">CHOOSE A RIVER TO EXPLORE <span>选择一条河流，开启旅程</span></div>
                <div class="p2-cards reveal delay-200">
                    <button onclick="goToPage(2)" class="p2-river-card gold-card">
                        <span class="p2-card-index">01 / EAST</span><span class="p2-card-name" data-i18n="p2_left_t">黄河 · 中原</span>
                        <span class="p2-card-desc" data-i18n="p2_left_d">黄土厚壤，粟作农耕与礼乐的温润摇篮。</span>
                        <span class="p2-card-action"><span data-i18n="explore_line">进入黄河线</span><b>↗</b></span>
                    </button>
                    <button onclick="goToPage(3)" class="p2-river-card blue-card">
                        <span class="p2-card-index">02 / WEST</span><span class="p2-card-name" data-i18n="p2_right_t">尼罗河 · 埃及</span>
                        <span class="p2-card-desc" data-i18n="p2_right_d">沙漠绿洲，黑土泛滥与神庙星辰的永恒长廊。</span>
                        <span class="p2-card-action"><span data-i18n="explore_line_nile">对照尼罗河线</span><b>↗</b></span>
                    </button>
                </div>
                <div class="p2-footnote reveal delay-300" data-i18n="p2_hint">左右滑动或点击进入双线文明旅程 · Swipe Left/Right</div>
            </section>

            <!-- =====================================================================
                 第 3 页：【黄河线 · 贾湖骨笛】
            ====================================================================== -->
            <section class="h5-page bg-gradient-to-b from-[#F8F1E5] to-[#EDE0C9] text-ink" data-index="2" data-theme="light">
                <div class="reveal">
                    <div class="flex items-center justify-between">
                        <span class="px-3 py-1 rounded-full bg-yellowRiver/15 text-yellowRiver text-xs font-bold tracking-wider">
                            黄河线 · YELLOW RIVER LINE
                        </span>
                        <span class="font-cinzel text-xs text-stone-500 font-bold">6000 BCE · 河南舞阳</span>
                    </div>
                    <h2 class="mt-2 font-serif text-2xl sm:text-3xl font-bold text-ink" data-i18n="p3_title">
                        黄河孕育人类最早的旋律
                    </h2>
                    <p class="text-xs text-stone-500 font-cinzel mt-0.5">Jiahu Bone Flute · Earliest Playable Melody</p>
                </div>

                <div class="my-auto p-5 rounded-3xl bg-white/90 shadow-lg border border-amber-900/15 reveal delay-100">
                    <div class="relative h-40 rounded-2xl bg-gradient-to-r from-amber-50 via-orange-50 to-amber-100/70 flex flex-col items-center justify-center p-4 overflow-hidden">
                        <svg viewBox="0 0 280 80" class="w-full max-w-xs drop-shadow-md">
                            <rect x="20" y="30" width="240" height="18" rx="9" fill="#E6D2B5" stroke="#8C5828" stroke-width="2"/>
                            <circle cx="75" cy="39" r="3.5" fill="#4A2E14"/>
                            <circle cx="102" cy="39" r="3.5" fill="#4A2E14"/>
                            <circle cx="129" cy="39" r="3.5" fill="#4A2E14"/>
                            <circle cx="156" cy="39" r="3.5" fill="#4A2E14"/>
                            <circle cx="183" cy="39" r="3.5" fill="#4A2E14"/>
                            <circle cx="210" cy="39" r="3.5" fill="#4A2E14"/>
                            <circle cx="235" cy="39" r="3" fill="#4A2E14"/>
                            <path d="M10 62 Q75 50 140 62 T270 62" fill="none" stroke="#C87A28" stroke-width="2" stroke-dasharray="5 4"/>
                        </svg>

                        <div id="flute-eq" class="flex items-end space-x-1 h-6 mt-1">
                            <span class="w-1 bg-yellowRiver rounded-full h-2 eq-1"></span>
                            <span class="w-1 bg-yellowRiver rounded-full h-3 eq-2"></span>
                            <span class="w-1 bg-yellowRiver rounded-full h-2 eq-3"></span>
                            <span class="w-1 bg-yellowRiver rounded-full h-4 eq-4"></span>
                        </div>
                    </div>

                    <div class="mt-4 flex flex-col items-center">
                        <button onclick="playAncientInstrument('flute')" class="group relative px-6 py-3 rounded-2xl bg-yellowRiver text-white font-serif font-bold text-sm shadow-md shadow-yellowRiver/30 hover:brightness-110 transition active:scale-95 flex items-center space-x-2">
                            <i data-lucide="droplets" class="w-4 h-4 text-amber-200 animate-bounce"></i>
                            <span data-i18n="p3_play">轻触水滴 · 聆听8000年前贾湖骨笛</span>
                        </button>
                    </div>

                    <p class="mt-4 text-xs sm:text-sm text-stone-600 leading-relaxed" data-i18n="p3_desc">
                        出土于河南舞阳贾湖遗址的七孔骨笛，由丹顶鹤尺骨制成，至今仍能吹奏出完整的七声音阶，改写了世界音乐史的起源时间。
                    </p>
                </div>

                <div class="flex justify-between items-center text-xs text-stone-500 reveal delay-200">
                    <span>01 / 乐律之源 · 黄河篇</span>
                    <button onclick="goToPage(3)" class="text-nileRiver font-bold flex items-center">
                        <span data-i18n="next_nile">对照尼罗河乐章</span>
                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                    </button>
                </div>
            </section>

            <!-- =====================================================================
                 第 4 页：【尼罗河线 · 古埃及竖琴】
            ====================================================================== -->
            <section class="h5-page bg-gradient-to-b from-[#EBF3F7] to-[#D8E7EE] text-ink" data-index="3" data-theme="light">
                <div class="reveal">
                    <div class="flex items-center justify-between">
                        <span class="px-3 py-1 rounded-full bg-nileRiver/15 text-nileRiver text-xs font-bold tracking-wider">
                            尼罗河线 · NILE RIVER LINE
                        </span>
                        <span class="font-cinzel text-xs text-stone-500 font-bold">3000 BCE · 底比斯</span>
                    </div>
                    <h2 class="mt-2 font-serif text-2xl sm:text-3xl font-bold text-ink" data-i18n="p4_title">
                        尼罗河畔，亦诞生古老乐章
                    </h2>
                    <p class="text-xs text-stone-500 font-cinzel mt-0.5">Ancient Egyptian Arched Harp · Sacred Melodies</p>
                </div>

                <div class="my-auto p-5 rounded-3xl bg-white/90 shadow-lg border border-cyan-900/15 reveal delay-100">
                    <div class="relative h-40 rounded-2xl bg-gradient-to-r from-cyan-50 via-sky-50 to-teal-100/60 flex flex-col items-center justify-center p-4 overflow-hidden">
                        <svg viewBox="0 0 220 110" class="h-28 w-auto drop-shadow-md">
                            <path d="M60 92 C45 55 75 18 145 16" fill="none" stroke="#1E5B70" stroke-width="8" stroke-linecap="round"/>
                            <line x1="72" y1="84" x2="138" y2="20" stroke="#D9A05B" stroke-width="1.5"/>
                            <line x1="82" y1="86" x2="128" y2="26" stroke="#D9A05B" stroke-width="1.5"/>
                            <line x1="92" y1="88" x2="118" y2="34" stroke="#D9A05B" stroke-width="1.5"/>
                            <line x1="102" y1="90" x2="108" y2="44" stroke="#D9A05B" stroke-width="1.5"/>
                            <ellipse cx="82" cy="90" rx="28" ry="9" fill="#2A7B96"/>
                        </svg>

                        <div id="harp-eq" class="flex items-end space-x-1 h-6 mt-1">
                            <span class="w-1 bg-nileRiver rounded-full h-2 eq-1"></span>
                            <span class="w-1 bg-nileRiver rounded-full h-3 eq-2"></span>
                            <span class="w-1 bg-nileRiver rounded-full h-2 eq-3"></span>
                            <span class="w-1 bg-nileRiver rounded-full h-4 eq-4"></span>
                        </div>
                    </div>

                    <div class="mt-4 flex flex-col items-center">
                        <button onclick="playAncientInstrument('harp')" class="px-6 py-3 rounded-2xl bg-nileRiver text-white font-serif font-bold text-sm shadow-md shadow-nileRiver/30 hover:brightness-110 transition active:scale-95 flex items-center space-x-2">
                            <i data-lucide="droplets" class="w-4 h-4 text-cyan-200 animate-bounce"></i>
                            <span data-i18n="p4_play">轻触水滴 · 聆听古埃及竖琴拨弦</span>
                        </button>
                    </div>

                    <p class="mt-4 text-xs sm:text-sm text-stone-600 leading-relaxed" data-i18n="p4_desc">
                        在尼罗河三角洲的神庙壁画中，乐师轻拨弓形竖琴礼赞河水泛滥。同一种水，催生了人类跨越山海的共同艺术本能。
                    </p>
                </div>

                <div class="p-3 rounded-2xl bg-nileRiver/10 border border-nileRiver/20 text-center text-xs text-nileRiver font-semibold reveal delay-200" data-i18n="p4_insight">
                    🌍 同一种水，同一种对音乐的向往，各自绽放的文明表达
                </div>
            </section>

            <!-- =====================================================================
                 第 5 页：【黄河线 · 甲骨文逐渐浮现】
            ====================================================================== -->
            <section class="h5-page bg-[#F6EFE2] text-ink" data-index="4" data-theme="light">
                <svg viewBox="0 0 640 1030" preserveAspectRatio="none" class="absolute inset-0 w-full h-full pointer-events-none">
                    <path d="M-30,110 C150,70 360,160 670,95 L670,380 C440,420 210,330 -30,390 Z" fill="#C87A28" fill-opacity="0.16" class="pigment-wash"/>
                    <path d="M80,720 C260,670 490,740 670,690 L670,1050 L-30,1050 Z" fill="#9E5B1E" fill-opacity="0.18" class="pigment-wash"/>
                </svg>

                <div class="z-10 reveal">
                    <div class="flex items-center justify-between">
                        <span class="px-3 py-1 rounded-full bg-yellowRiver/15 text-yellowRiver text-xs font-bold tracking-wider">
                            黄河线 · 东方表意文明
                        </span>
                        <span class="font-cinzel text-xs text-stone-500 font-bold">1300 BCE · 安阳殷墟</span>
                    </div>
                    <h2 class="mt-2 font-serif text-2xl sm:text-3xl font-bold text-ink" data-i18n="p5_title">
                        水润厚土，甲骨生辉
                    </h2>
                    <p class="text-xs text-stone-500 font-cinzel mt-0.5">Oracle Bone Script · Eastern Ideographic Civilization</p>
                </div>

                <div class="z-10 my-auto p-5 rounded-3xl bg-white/90 shadow-lg border border-amber-900/15 reveal delay-100">
                    <div class="flex justify-between items-center mb-3">
                        <span class="text-xs font-bold text-yellowRiver" data-i18n="p5_hint">👆 点击下方按钮或甲骨，演示甲骨文逐渐浮现</span>
                        <span class="text-[11px] px-2 py-0.5 rounded bg-amber-100 text-amber-900 font-semibold">UNESCO 世界记忆</span>
                    </div>

                    <div class="h-48 rounded-2xl bg-[#F5EAD6] border-2 border-dashed border-amber-800/30 flex items-center justify-around px-4 relative overflow-hidden">
                        <div id="oracle-water-stain" class="absolute inset-0 bg-radial from-amber-500/20 to-transparent opacity-0 transition-opacity duration-1000 pointer-events-none"></div>

                        <div id="oracle-char-1" class="flex flex-col items-center script-emerge">
                            <svg viewBox="0 0 100 120" class="w-24 h-28">
                                <path id="oracle-path-1" class="stroke-reveal" d="M50 15 Q42 40 52 60 T48 105" fill="none" stroke="#5C3A18" stroke-width="5" stroke-linecap="round"/>
                                <path id="oracle-path-2" class="stroke-reveal" d="M25 35 L25 45 M25 75 L25 85 M75 35 L75 45 M75 75 L75 85" fill="none" stroke="#C87A28" stroke-width="5" stroke-linecap="round"/>
                            </svg>
                            <span id="oracle-label-1" class="text-xs font-serif font-bold text-ink transition-opacity duration-1000" style="opacity:0">甲骨文 · 水 (Water)</span>
