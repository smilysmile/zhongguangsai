<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>一水同源 · 双河文明交响 | One Water, One Civilization</title>
    <!-- 引入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 引入 Google Fonts: 思源宋体 & Cinzel & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Inter:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@400;600;700;900&display=swap" rel="stylesheet">
    <!-- 引入 Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        serif: ['"Noto Serif SC"', 'Cinzel', 'serif'],
                        cinzel: ['Cinzel', 'serif'],
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        yellowRiver: '#C87A28',   // 黄河暖赭金
                        yellowBg: '#F6EFE2',      // 黄土温润宣纸
                        nileRiver: '#1E5B70',     // 尼罗河深青蓝
                        nileBg: '#EBF2F5',        // 尼罗河冷调沙雾
                        waterGlow: '#5CE1E6',     // 生命之水琉璃光
                        ink: '#1A1816',
                    }
                }
            }
        }
    </script>

    <style>
        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: #0E1113;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
        }

        /* 640 x 1030 移动端黄金比例主容器 */
        #app-viewport {
            position: relative;
            width: 100vw;
            height: 100vh;
            max-width: 640px;
            max-height: 1030px;
            background-color: #12171A;
            overflow: hidden;
            box-shadow: 0 30px 70px rgba(0, 0, 0, 0.75);
        }

        @media (min-width: 641px) {
            #app-viewport {
                height: 94vh;
                aspect-ratio: 640 / 1030;
                border-radius: 30px;
                border: 6px solid #232A2E;
            }
        }

        /* 13页平滑切换容器 */
        #pages-wrapper {
            width: 100%;
            height: 100%;
            transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
            will-change: transform;
        }

        .h5-page {
            width: 100%;
            height: 100%;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 4.5rem 1.75rem 3rem 1.75rem;
        }

        /* 入场动效 */
        .reveal {
            opacity: 0;
            transform: translateY(22px);
            transition: all 0.75s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .h5-page.active .reveal {
            opacity: 1;
            transform: translateY(0);
        }
        .delay-100 { transition-delay: 0.12s; }
        .delay-200 { transition-delay: 0.24s; }
        .delay-300 { transition-delay: 0.36s; }

        /* 水滴呼吸光晕动画 */
        @keyframes waterBreathe {
            0%, 100% {
                transform: scale(1) translateY(0px);
                filter: drop-shadow(0 0 18px rgba(92, 225, 230, 0.55));
            }
            50% {
                transform: scale(1.07) translateY(-6px);
                filter: drop-shadow(0 0 32px rgba(92, 225, 230, 0.85));
            }
        }
        .animate-water-breathe {
            animation: waterBreathe 3.2s infinite ease-in-out;
        }

        /* 水滴坠落过渡动效 */
        @keyframes dropFall {
            0% { transform: translateY(0) scale(1); opacity: 1; }
            72% { transform: translateY(185px) scale(.96, 1.08); opacity: 1; }
            88% { transform: translateY(220px) scale(1.04, .96); opacity: .96; }
            100% { transform: translateY(238px) scale(1.08, .9); opacity: 0; }
        }
        .dropping {
            animation: dropFall 2.8s cubic-bezier(0.38, 0.05, 0.2, 1) forwards !important;
        }
        .p2-drop-left, .p2-drop-right { transform-box: fill-box; transform-origin: center; }
        @keyframes splitLeft {
            0% { transform: translate(75px,-104px) scale(.68); opacity:0; }
            18% { opacity:1; }
            100% { transform: translate(0,0) scale(1); opacity:1; }
        }
        @keyframes splitRight {
            0% { transform: translate(-75px,-104px) scale(.68); opacity:0; }
            18% { opacity:1; }
            100% { transform: translate(0,0) scale(1); opacity:1; }
        }
        .p2-drop-left.animate { animation: splitLeft 2.4s cubic-bezier(.2,.7,.25,1) both; }
        .p2-drop-right.animate { animation: splitRight 2.4s cubic-bezier(.2,.7,.25,1) both; }

        /* 水波纹扩散动画 */
        @keyframes rippleExpand {
            0% { transform: scale(0.8); opacity: 0.85; }
            100% { transform: scale(2.4); opacity: 0; }
        }
        .ripple-ring {
            animation: rippleExpand 2.2s infinite ease-out;
        }
        .ripple-ring-delay {
            animation: rippleExpand 2.2s infinite ease-out 1.1s;
        }

        /* 声波跳动动画 */
        @keyframes eqBar {
            0%, 100% { height: 6px; }
            50% { height: 24px; }
        }
        .playing .eq-1 { animation: eqBar 0.5s infinite ease-in-out; }
        .playing .eq-2 { animation: eqBar 0.4s infinite ease-in-out 0.15s; }
        .playing .eq-3 { animation: eqBar 0.6s infinite ease-in-out 0.3s; }
        .playing .eq-4 { animation: eqBar 0.45s infinite ease-in-out 0.2s; }

        /* 笔画描边渐显 */
        .stroke-reveal {
            stroke-dasharray: 300;
            stroke-dashoffset: 300;
            transition: stroke-dashoffset 1.6s ease-in-out;
        }
        .stroke-reveal.drawn {
            stroke-dashoffset: 0;
        }

        /* 矿物颜料晕染色块高级质感 */
        .pigment-wash {
            filter: url(#watercolor-edge);
            mix-blend-mode: multiply;
            transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1), opacity 1s ease;
        }
        .pigment-wash-screen {
            filter: url(#watercolor-edge);
            mix-blend-mode: screen;
        }

        /* 文字水浸渐显动效 */
        .script-emerge {
            opacity: 0;
            filter: blur(6px);
            transform: scale(0.92);
            transition: opacity 1.4s ease, filter 1.4s ease, transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .script-emerge.visible {
            opacity: 1;
            filter: blur(0px);
            transform: scale(1);
        }

        /* 水痕路径流动动画 */
        @keyframes traceFlow {
            0% { stroke-dashoffset: 600; opacity: 0.2; }
            40% { opacity: 1; }
            100% { stroke-dashoffset: 0; opacity: 0.85; }
        }
        .water-trace-active {
            stroke-dasharray: 600;
            stroke-dashoffset: 600;
            animation: traceFlow 1.1s cubic-bezier(0.25, 1, 0.5, 1) forwards;
        }
    </style>

