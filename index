        function drawWaterConnectionLine(pairId) {
            const svg = document.getElementById('match-lines-svg');
            const wrapper = document.getElementById('game-board-wrapper');
            const lEl = document.getElementById(`left-${pairId}`);
            const rEl = document.getElementById(`right-${pairId}`);
            if (!svg || !wrapper || !lEl || !rEl) return;

            const wrapRect = wrapper.getBoundingClientRect();
            const lRect = lEl.getBoundingClientRect();
            const rRect = rEl.getBoundingClientRect();

            if (wrapRect.width === 0) return;

            const x1 = lRect.right - wrapRect.left;
            const y1 = lRect.top + lRect.height / 2 - wrapRect.top;
            const x2 = rRect.left - wrapRect.left;
            const y2 = rRect.top + rRect.height / 2 - wrapRect.top;
            const midX = (x1 + x2) / 2;

            const d = `M ${x1} ${y1} C ${midX} ${y1 - 12}, ${midX} ${y2 + 12}, ${x2} ${y2}`;

            const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
            path.setAttribute("d", d);
            path.setAttribute("fill", "none");
            path.setAttribute("stroke", "#2A93A8");
            path.setAttribute("stroke-width", "3.5");
            path.setAttribute("stroke-linecap", "round");
            path.classList.add("water-trace-active");

            const dot1 = document.createElementNS("http://www.w3.org/2000/svg", "circle");
            dot1.setAttribute("cx", x1);
            dot1.setAttribute("cy", y1);
            dot1.setAttribute("r", "4");
            dot1.setAttribute("fill", "#C87A28");

            const dot2 = document.createElementNS("http://www.w3.org/2000/svg", "circle");
            dot2.setAttribute("cx", x2);
            dot2.setAttribute("cy", y2);
            dot2.setAttribute("r", "4");
            dot2.setAttribute("fill", "#1E5B70");

            svg.appendChild(path);
            svg.appendChild(dot1);
            svg.appendChild(dot2);
        }

