                        osc.frequency.setValueAtTime(freq, now + i * 0.32);
                        gain.gain.setValueAtTime(0.28, now + i * 0.32);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.32 + 0.75);
                        osc.connect(gain);
                        gain.connect(ctx.destination);
                        osc.start(now + i * 0.32);
